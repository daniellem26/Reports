SELECT SUM(totalcount) AS 'Total Checkouts in Range'
FROM (
    SELECT COUNT(*) AS totalcount
    FROM issues
    WHERE borrowernumber IN <<example list |list>>
    AND issuedate BETWEEN <<Start date|date>> AND (<<End date|date>> + interval 1 day)

    UNION ALL

    SELECT COUNT(*) AS totalcount
    FROM old_issues
    WHERE borrowernumber IN <<example list |list>>
    AND returndate BETWEEN <<Start date|date>> AND (<<End date|date>> + interval 1 day)
) AS total
